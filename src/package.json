{
  "name": "staff-shift-management",
  "version": "1.0.0",
  "private": true,
  "description": "Staff shift management backend (Node.js)",
  "main": "api/app.js",
  "scripts": {
    "dev": "nodemon api/app.js",
    "start": "node api/app.js",
    "worker:ocr": "node worker/ocr.worker.js",
    "worker:mapping": "node worker/mapping.worker.js",
    "migrate": "knex --knexfile db/knexfile.js migrate:latest",
    "migrate:rollback": "knex --knexfile db/knexfile.js migrate:rollback",
    "seed": "knex --knexfile db/knexfile.js seed:run"
  },
  "dependencies": {
    "amqplib": "^0.10.4",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "knex": "^3.1.0",
    "minio": "^8.0.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.10.0",
    "pino": "^9.3.2",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
